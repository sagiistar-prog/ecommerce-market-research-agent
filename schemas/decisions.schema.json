{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "target_user": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "problem_statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "proposed_change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "reasoning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "status": {
            "const": "hypothesis"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(E[0-9]{3}|BRIEF)$"
                },
                "field": {
                  "enum": [
                    "original_brief",
                    "brand",
                    "channel",
                    "positioning_claim",
                    "key_feature",
                    "content_hook",
                    "notes"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "id",
                "field",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000,
              "pattern": "\\S"
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              },
              "primary_metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              },
              "guardrail_metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              },
              "decision_rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              }
            },
            "required": [
              "method",
              "primary_metric",
              "guardrail_metric",
              "decision_rule"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "target_user",
          "problem_statement",
          "proposed_change",
          "reasoning",
          "status",
          "evidence",
          "assumptions",
          "validation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "proposals"
  ],
  "additionalProperties": false
}
